# Copy to .env and fill in. Never commit .env.

# Console home page -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Console -> Account -> API keys & tokens -> Create API key (Standard)
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret

# Console -> Voice -> TwiML Apps -> the app whose Voice URL is <PUBLIC_BASE_URL>/voice
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio number (trial number for now) in E.164 format
TWILIO_CALLER_ID=+15551234567

# Your ngrok HTTPS URL, no trailing slash
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Checks that /voice and /call-status requests really come from Twilio
VALIDATE_TWILIO_SIGNATURE=true

# Optional: non-US numbers allowed for testing, e.g. your own verified cell (comma-separated)
ALLOWED_TEST_NUMBERS=

# Secret-link protection: open the app as https://your-app/?key=THIS_VALUE once.
# Leave empty to make the dialer open to anyone with the URL (not recommended online).
ACCESS_KEY=

# Postgres connection string (e.g. Neon). Leave empty to use local SQLite (dialer.db).
DATABASE_URL=
